# Copy to ~/.config/mailbag/mailbag.env and fill it in. The SMTP password is a Podman secret, not set here.
MAILBAG_SMTP_USER=sender@gmail.com
MAILBAG_TO=you@gmail.com
MAILBAG_APPS=paperback,fedra
# Client addresses and ranges to refuse, separated by commas. Restart the service after changing it.
#MAILBAG_BLOCK=203.0.113.7, 198.51.100.0/24
